# Solo lo que docker-compose.yaml necesita para SU PROPIA sustitucion ${...}
# (puertos publicados al host, y el build-arg de client) -- Compose no puede
# leer el .env de otra carpeta para esto, es un limite de la herramienta.
# Todo lo demas vive en el .env de cada servicio (api/.env, n8n/.env,
# database/.env, database/redis/.env), inyectado via env_file.

APP_PORT=3000
APP_CONTAINER_PORT=3000

N8N_PORT=5678

POSTGRES_PORT=5432

REDIS_PORT=6380

VITE_API_BASE_URL=http://localhost:3000/api/v1
