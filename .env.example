# Solo lo que docker-compose.yaml necesita para SU PROPIA sustitucion ${...}
# (puertos publicados al host) -- Compose no puede
# leer el .env de otra carpeta para esto, es un limite de la herramienta.
# Todo lo demas vive en el .env de cada servicio (api/.env, automation/.env,
# infra/database/.env, infra/redis/.env) inyectado via env_file, y en
# client/.env.production, que vite build lee al construir la imagen.

APP_PORT=3000
APP_CONTAINER_PORT=3000

N8N_PORT=5678

POSTGRES_PORT=5432

REDIS_PORT=6380
