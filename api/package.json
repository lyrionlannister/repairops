{
  "name": "repairops-api",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:arch": "depcruise src --config .dependency-cruiser.cjs",
    "seed:demo": "tsx src/scripts/seed-demo.ts",
    "migration:generate": "typeorm-ts-node-esm migration:generate -d src/core/config/migration-data-source.ts",
    "migration:run": "typeorm-ts-node-esm migration:run -d src/core/config/migration-data-source.ts",
    "migration:revert": "typeorm-ts-node-esm migration:revert -d src/core/config/migration-data-source.ts",
    "migration:run:prod": "typeorm migration:run -d dist/core/config/migration-data-source.js",
    "schema:log": "typeorm-ts-node-esm schema:log -d src/core/config/migration-data-source.ts",
    "schema:check": "pnpm migration:run && pnpm schema:log | tee schema-check.log && grep -q 'Your schema is up to date' schema-check.log"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.2",
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cors": "^2.8.6",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.3.1",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.5",
    "tsyringe": "^4.10.0",
    "typeorm": "^0.3.31",
    "xlsx": "https://cdn.sheetjs.com/xlsx-latest/xlsx-latest.tgz"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "dependency-cruiser": "^16.10.4",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "glob": "^14.0.2"
    }
  }
}
