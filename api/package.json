{
  "name": "repairops-api",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "build": "tsc",
    "dev": "concurrently -k -n tsc,api \"tsc --watch --preserveWatchOutput\" \"nodemon --watch dist dist/index.js\"",
    "start": "node dist/index.js",
    "test": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:arch": "depcruise src --config .dependency-cruiser.cjs",
    "migration:generate": "tsx ./node_modules/typeorm/cli.js migration:generate -d src/core/config/migration-data-source.ts",
    "migration:run": "tsx ./node_modules/typeorm/cli.js migration:run -d src/core/config/migration-data-source.ts",
    "migration:revert": "tsx ./node_modules/typeorm/cli.js migration:revert -d src/core/config/migration-data-source.ts",
    "migration:run:prod": "typeorm migration:run -d dist/core/config/migration-data-source.js",
    "schema:log": "tsx ./node_modules/typeorm/cli.js schema:log -d src/core/config/migration-data-source.ts",
    "schema:check": "pnpm migration:run && pnpm schema:log | tee schema-check.log && grep -q 'Your schema is up to date' schema-check.log",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@12.21.0",
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cors": "^2.8.6",
    "decimal.js": "^10.6.0",
    "express": "^5.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "oci-common": "^2.146.0",
    "oci-objectstorage": "^2.146.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.5",
    "tsyringe": "^4.10.0",
    "typeorm": "^0.3.31",
    "xlsx": "https://cdn.sheetjs.com/xlsx-latest/xlsx-latest.tgz"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.7",
    "dependency-cruiser": "^16.10.4",
    "nodemon": "^3.1.14",
    "prettier": "^3.10.1",
    "sql-formatter": "^15.9.0",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.3.5",
    "vitest": "^4.1.12"
  }
}
