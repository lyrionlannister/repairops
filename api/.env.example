# Consumido por docker-compose.yaml via env_file para el servicio "api" --
# siempre valores de contenedor (hostnames de servicio: postgres, redis, n8n).

# Database (app_db)
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=n8n
DB_PASSWORD=n8n_password_dev
DB_NAME=app_db


# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Redis (puerto interno del contenedor, siempre 6379)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USER=admin
REDIS_PASSWORD=your-redis-password-change-in-production

# Secreto compartido para /api/v1/n8n/* y /api/v1/import-staging/callback (llamadas internas desde n8n, sin JWT)
N8N_INTERNAL_TOKEN=change-this-token

# WhatsApp oficial (Fase 4) -- clave unica AES-256-GCM (hex de 64 chars, 32 bytes)
# para cifrar accessToken en WhatsappAccount, y cuenta piloto compartida de la
# plataforma (Etapa 1, sin OAuth por tenant todavia)
ENCRYPTION_KEY=change-this-to-a-64-char-hex-string-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
WHATSAPP_PILOT_WABA_ID=
WHATSAPP_PILOT_PHONE_NUMBER_ID=
WHATSAPP_PILOT_ACCESS_TOKEN=

# Webhook entrante de Meta (Fase 4, Checkpoint 4): APP_SECRET firma cada
# POST (X-Hub-Signature-256); VERIFY_TOKEN es el que se configura en el
# panel de Meta para el handshake GET de suscripcion.
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Server
PORT=3000
AUTOMATION_URL=http://n8n:5678/webhook/97c71c06-20b2-4c12-a8be-16442536f909

# Stripe (sin consumidor en codigo todavia -- prep para Fase 6)

# Opcionales, con default ya apuntando al hostname correcto dentro de la red
# de contenedores -- solo sobreescribir si el workflow de n8n o la URL de
# callback cambian:
# IMPORT_STAGING_WEBHOOK_URL=http://n8n:5678/webhook/import-staging
# API_INTERNAL_URL=http://api:3000

# Archivos de WhatsApp (imagen, audio, video, documento): fs en desarrollo, oci en produccion
MEDIA_STORAGE=fs
MEDIA_STORAGE_DIR=./media-storage
OCI_REGION=
OCI_NAMESPACE=
OCI_BUCKET=
OCI_TENANCY_OCID=
OCI_USER_OCID=
OCI_FINGERPRINT=
OCI_PRIVATE_KEY=
